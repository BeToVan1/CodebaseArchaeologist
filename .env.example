# Optional: enables evidence-grounded AI interpretation in the local analyzer API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional local CLI evidence preview only; no LLM calls. Bind api:app to
# 127.0.0.1 with one worker. Use a separate random token, not the Oracle token.
# Never put this token in frontend code or NEXT_PUBLIC_ variables.
ARCHAEOLOGIST_LOCAL_EVIDENCE_ENABLED=false
ARCHAEOLOGIST_LOCAL_EVIDENCE_TOKEN=

# Private Linux deep service only. Generate a random secret of at least 32 ASCII
# characters at deployment time. Never set this as a NEXT_PUBLIC_ variable.
ARCHAEOLOGIST_SERVICE_TOKEN=

# Oracle only: existing initialized ledger in the dedicated persistent mount.
ARCHAEOLOGIST_QUOTA_PATH=/var/lib/archaeologist-quota/quota.sqlite3

# Website Worker only: enable only after the quota-v1 backend is validated.
# The secret above is shared with Oracle, never sent to the browser.
ARCHAEOLOGIST_DEEP_ENABLED=false

# Website Worker only: enable after verifying a Cloudflare Workers Free account.
# Use either a managed AI binding or both server-only REST credentials below.
# The API token needs only Workers AI permission. Never use NEXT_PUBLIC_.
ARCHAEOLOGIST_INTERPRETATION_ENABLED=false
ARCHAEOLOGIST_CF_ACCOUNT_ID=
ARCHAEOLOGIST_CF_AI_TOKEN=
