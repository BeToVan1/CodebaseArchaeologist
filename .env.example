# Optional: enables evidence-grounded AI interpretation in the local analyzer API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Private Linux deep service only. Generate a random secret of at least 32 ASCII
# characters at deployment time. Never set this as a NEXT_PUBLIC_ variable.
ARCHAEOLOGIST_SERVICE_TOKEN=

# Oracle only: existing initialized ledger in the dedicated persistent mount.
ARCHAEOLOGIST_QUOTA_PATH=/var/lib/archaeologist-quota/quota.sqlite3

# Website Worker only: enable only after the quota-v1 backend is validated.
# The secret above is shared with Oracle, never sent to the browser.
ARCHAEOLOGIST_DEEP_ENABLED=false
